{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WorkJoy desktop permissions",
  "windows": ["main", "reader", "mini", "mini-menu"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "store:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "global-shortcut:default",
    "autostart:default",
    "process:default"
  ]
}
